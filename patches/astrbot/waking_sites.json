    "",
    "def _ms_render_chain(event) -> str:",
    "    \"\"\"按消息链渲染文本，**保留「@ 自己」**。",
    "",
    "    event.message_str 在构建时会把「@ 本 bot」那一段去掉，于是缓冲里只剩",
    "    「发送者: 内容」—— bot 根本看不出这句话是直接对它说的。这里自己渲染。",
    "    \"\"\"",
    "    parts = []",
    "    for c in (event.get_messages() or []):",
    "        n = type(c).__name__",
    "        if n == 'At':",
    "            nm = getattr(c, 'name', '') or ''",
    "            parts.append('@' + (str(nm) or str(getattr(c, 'qq', ''))))",
    "        elif n == 'AtAll':",
    "            parts.append('@全体成员')",
    "        elif n == 'Plain':",
    "            parts.append(str(getattr(c, 'text', '') or ''))",
    "        elif n == 'Image':",
    "            parts.append('[图片]')",
    "        elif n == 'Face':",
    "            parts.append('[' + (str(getattr(c, 'name', '') or '') or '表情') + ']')",
    "        elif n == 'Reply':",
    "            parts.append('[引用]')",
    "    s = ''.join(parts).strip()",
    "    return s or str(event.message_str or '')",
    "",
    "",
    "def _ms_image_refs(event) -> list:",
    "    \"\"\"本条消息带的图 → 「引用」列表：本地路径优先，其次可下载的 URL。\"\"\"",
    "    import os as _o",
    "    out = []",
    "    for c in (event.get_messages() or []):",
    "        if type(c).__name__ != 'Image':",
    "            continue",
    "        ref = ''",
    "        for attr in ('path', 'file', 'url'):",
    "            v = getattr(c, attr, '') or ''",
    "            if not isinstance(v, str) or not v:",
    "                continue",
    "            if v.startswith('/') and _o.path.exists(v):",
    "                ref = v",
    "                break",
    "            if not ref and v.startswith(('http://', 'https://', 'file://')):",
    "                ref = v",
    "        if ref and ref not in out:",
    "            out.append(ref)",
    "    return out",
    "",
    "",
    "# ── 别的 bot 的查询指令识别（2026-10-06）────────────────────────────",
    "# 群里还有别的机器人（典型：云崽系 = Yunzai-Bot + miao-plugin），命令形如",
    "# 「#角色面板」「*<名字>光锥」——**恰好含 bot 的名字**，会被「提到名字」规则叫醒，",
    "# 还容易被记成「又来问面板/配置」写进印象层。",
    "# 判据（三条都满足才算）：① #/* 开头 ② 名字+查询词收尾 ③ 没有别的文字。",
    "# ⚠️ 不许把关键词直接拉黑 —— 真问游戏知识（「<名字>，行迹怎么点」）必须照常回。",
    "_SPARXIE_CMD_CFG = '/opt/astrbot/data/auto_wake_cfg.json'",
    "_SPARXIE_CMD_CACHE = {'mtime': -1.0, 'cfg': {}}",
    "# 「角色名」部分：允许空（#面板）或一个短名字（#<名字>面板），不许含空格/标点",
    "_SPARXIE_CMD_NAME = r'^[^\\s，。！？、,.!?#*：:；;~～\\-_/|]{0,12}$'",
    "",
    "",
    "def _ms_cmd_cfg() -> dict:",
    "    \"\"\"读配置里的 ignore_cmd 段（按 mtime 缓存）。\"\"\"",
    "    try:",
    "        import json as _j, os as _o",
    "        mt = _o.path.getmtime(_SPARXIE_CMD_CFG)",
    "        if mt != _SPARXIE_CMD_CACHE['mtime']:",
    "            with open(_SPARXIE_CMD_CFG, encoding='utf-8') as _f:",
    "                _doc = _j.load(_f) or {}",
    "            _SPARXIE_CMD_CACHE['cfg'] = _doc.get('ignore_cmd') or {}",
    "            _SPARXIE_CMD_CACHE['mtime'] = mt",
    "    except Exception:",
    "        pass",
    "    return _SPARXIE_CMD_CACHE['cfg']",
    "",
    "",
    "def _ms_is_cmd_query(text) -> bool:",
    "    \"\"\"这条是不是「别的 bot 的查询指令」（是 → 不唤醒、不进缓冲）。\"\"\"",
    "    cfg = _ms_cmd_cfg()",
    "    if not cfg or not cfg.get('enabled', True):",
    "        return False",
    "    import re as _r",
    "    t = str(text or '').strip()",
    "    if len(t) < 2 or t[0] not in (cfg.get('prefixes') or ['#', '*']):",
    "        return False",
    "    body = t[1:].strip()",
    "    if not body:",
    "        return False",
    "    for k in (cfg.get('keywords') or []):",
    "        if k and body.endswith(k):",
    "            return bool(_r.match(_SPARXIE_CMD_NAME, body[: -len(k)].strip()))",
    "    return False",
    "",
    "def _ms_record_ctx(event) -> None:",
    "    \"\"\"mindscape: 记录群消息到缓冲文件，供 group_context_buffers 插件读取。",
    "    解决未唤醒消息不进 LLM 上下文的问题。\"\"\"",
    "    try:",
    "        # 别的 bot 的查询指令不进缓冲（否则她回复时会在上下文里看见「#<名字>面板」）",
    "        if _ms_is_cmd_query(_ms_render_chain(event)):",
    "            return",
    "        import json as _j, os as _o, time as _t, fcntl as _f",
    "        _p = '/opt/astrbot/data/group_ctx_buffer.jsonl'",
    "        _rec = {",
    "            'ts': _t.time(),",
    "            'platform': str(event.get_platform_name()),",
    "            'self_id': str(event.get_self_id()),",
    "            'group': str(event.get_group_id()),",
    "            'uid': str(event.get_sender_id()),",
    "            'who': str(event.get_sender_name() or event.get_sender_id())[:24],",
    "            'text': _ms_render_chain(event)[:300],  # ── mindscape-fix: 引用/Bot 定向性 ──",
    "        }",
    "        _imgs = _ms_image_refs(event)",
    "        if _imgs:",
    "            _rec['imgs'] = _imgs",
    "        if not _rec['text'].strip():",
    "            return",
    "        with open(_p, 'a', encoding='utf-8') as _fp:",
    "            _f.flock(_fp.fileno(), _f.LOCK_EX)",
    "            _fp.write(_j.dumps(_rec, ensure_ascii=False) + chr(10))",
    "            _f.flock(_fp.fileno(), _f.LOCK_UN)",
    "        try:",
    "            if _o.path.getsize(_p) > 2_000_000:",
    "                _ls = open(_p, encoding='utf-8').readlines()[-2000:]",
    "                open(_p, 'w', encoding='utf-8').writelines(_ls)",
    "        except Exception:",
    "            pass",
    "    except Exception:",
    "        pass",
    "",
    ""
   ],
