   "new": [
    "    def _gate_pass(self, job) -> bool:",
    "        # mindscape-fix: 冒泡闸门（改版）。",
    "        # payload.gate = {\"daily_count\": N, \"window\": [起, 止]}   # 分钟，0~1440",
    "        # 做法：把窗口均分成 N 段，每段里随机取一分钟当天的开口时刻 ——",
    "        #   时间随机、不整点；段与段天然拉开距离，不会聚成一堆。",
    "        # 种子 = job_id + 日期 → **重启不会重排**，同一天的时间是稳定的。",
    "        g = (job.payload or {}).get(\"gate\")",
    "        if not isinstance(g, dict):",
    "            return True",
    "        n = int(g.get(\"daily_count\") or 0)",
    "        if n <= 0:",
    "            return True",
    "        import random as _r, zlib as _z, datetime as _dt",
    "        st = self._gate_state.setdefault(job.job_id, {})",
    "        today = _dt.date.today().isoformat()",
    "        if st.get(\"day\") != today:",
    "            win = g.get(\"window\") or [0, 1440]",
    "            lo = int(win[0])",
    "            hi = max(lo + 1, int(win[1]))",
    "            span = hi - lo",
    "            rng = _r.Random(_z.crc32((str(job.job_id) + today).encode()))",
    "            slots = set()",
    "            for k in range(n):",
    "                a = lo + span * k // n",
    "                b = lo + span * (k + 1) // n",
    "                if b > a:",
    "                    slots.add(rng.randrange(a, b))",
    "            st[\"day\"] = today",
    "            st[\"slots\"] = slots",
    "            st[\"fired\"] = set()",
    "            logger.info(\"[cron-gate] %s 今天抽到 %s\", job.name,",
    "                        [\"%02d:%02d\" % (m // 60, m % 60) for m in sorted(slots)])",
    "        now = _dt.datetime.now()",
    "        cur = now.hour * 60 + now.minute",
    "        if cur in st.get(\"slots\", ()) and cur not in st.get(\"fired\", ()):",
    "            st[\"fired\"].add(cur)",
    "            logger.info(\"[cron-gate] %s 过闸（%02d:%02d）\", job.name, now.hour, now.minute)",
    "            return True",
    "        return False",
    ""
   ],
